APP_NAME="CHIS Simulation"

# MySQL/MariaDB — a separate database from Telemed's own `telemed` database,
# same server is fine (e.g. local XAMPP). Created automatically on first
# request if it doesn't exist yet.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chis_simulation
DB_USERNAME=root
DB_PASSWORD=

# Shared secret Telemed's RealChisClient must send as
# `Authorization: Bearer <key>` on every /api/patients/... call into this
# app. Mirror this exact value in Telemed's CHIS_SIM_API_KEY once that side
# is built.
CHIS_SIM_API_KEY=demo-chis-sim-key-change-me

# Where Telemed is running, for the outbound "Pull Encounter" demo (added in
# a later step).
TELEMED_BASE_URL=http://localhost:8000

# Sanctum bearer token this app sends to Telemed's
# GET /api/v1/consultations/{id}/encounter-summary. Issue one on the Telemed
# side with `php artisan chis:issue-token` and paste the plaintext here.
TELEMED_TOKEN=
